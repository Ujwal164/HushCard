<!DOCTYPE html>
<html>

<head>
  <title>HushCard - Secrets From The Darkness</title>

  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Special+Elite&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="/styles/main.css">
</head>

<body>

  <div class="fog"></div>

  <h1 class="title">HushCard</h1>

  <p class="subtitle">A whisper hidden in the darkness...</p>

  <div class="card">
    <div class="glow"></div>

    <p class="secret">
      "<%= secret %>"
    </p>

    <p class="user">
      — <%= user %>
    </p>

  </div>

</body>

</html>